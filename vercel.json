{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent/run.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/agent/run",
      "schedule": "17 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.morpho.org; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    }
  ]
}
