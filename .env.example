# Public Arc RPC URL used for read-only market data.
VITE_HOUSE_URL=https://cofferhouse.cheesemachineco.chatgpt.site
VITE_HOLDER_CENTER_URL=https://cofferhouse-scout.vercel.app/#holders
VITE_AGENT_SUITE_URL=https://cofferhouse-scout.vercel.app/#agents
VITE_REPOSITORY_URL=https://github.com/CofferHouse/cofferhouse-agent-suite

ARC_RPC_URL=https://your-secure-arc-mainnet-rpc.example

# Optional explorer base URL.
ARC_EXPLORER_URL=

# Optional supported market address for local development.
SCOUT_MARKET_ADDRESS=

# Never place private keys or secrets in this file.
# Required for the secure 24/7 agent runtime on Vercel.
CRON_SECRET=replace-with-at-least-16-random-characters
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token

# Optional Slack/Discord-compatible webhook for deduplicated material alerts.
SCOUT_ALERT_WEBHOOK_URL=https://your-protected-webhook-url

# Optional bounded incident explanation. Deterministic decisions work without it.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash

# Optional official Uniswap Trading API quote integration for Arc chain ID 5042.
UNISWAP_API_KEY=replace-with-your-uniswap-developer-key

# Optional Circle Arc App Kits key. Required for Onramp and recommended for production Earn traffic.
# Server-side only; never prefix with VITE_.
CIRCLE_API_KEY=replace-with-your-circle-app-kits-key

# Required to acknowledge incidents and register/remove durable Guardian watches.
# Entered transiently by the operator; never stored in the browser.
SCOUT_OPERATOR_TOKEN=replace-with-a-long-random-operator-secret

# Optional only after the receipt registry is compiled, reviewed, deployed, and operator-approved.
SCOUT_RECEIPT_REGISTRY_ADDRESS=
